import Bzip2.Oracle.Compress

/-!
# Oracle byte-exact compression tests

Checks short periodic streams against fixed output from the vendored compressor.
The larger periodic blocks and all three levels are checked by
`tests/vectors/byte-exact/check.py` after building `bzip2-oracle`.
-/

open Bzip2.Oracle

#guard match compress 1 "a".toUTF8 with
  | .ok z => z == ByteArray.mk #[
  0x42, 0x5a, 0x68, 0x31, 0x31, 0x41, 0x59, 0x26, 0x53, 0x59, 0x19, 0x93,
  0x9b, 0x6b, 0x00, 0x00, 0x00, 0x01, 0x00, 0x20, 0x00, 0x20, 0x00, 0x21,
  0x18, 0x46, 0x82, 0xee, 0x48, 0xa7, 0x0a, 0x12, 0x03, 0x32, 0x73, 0x6d,
  0x60
 ]
  | .error _ => false

